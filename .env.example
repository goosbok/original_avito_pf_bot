# ── Database ──────────────────────────────────────────────────────────────────
# В Docker — путь внутри named volume storage:/app/storage
DATABASE_PATH=/app/storage/database.db

# ── Yookassa payments ─────────────────────────────────────────────────────────
SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST=
# Payment health probe interval in minutes (0 = disabled, default 15)
PAYMENT_PROBE_INTERVAL_MIN=15

# ── Google Sheets exports ─────────────────────────────────────────────────────
# Email, на который будет передаваться ownership созданных таблиц.
# Без этого файлы остаются за service-аккаунтом и съедают его 0-байтную
# Drive-квоту → через какое-то время экспорт начнёт падать с
# storageQuotaExceeded.
# Для consumer @gmail.com Google делает pendingOwner: ты получишь письмо
# "...wants to transfer ownership..." и должен один раз нажать Accept в Drive.
# После этого файл уходит к тебе в Мой Диск, SA-квота освобождается.
GSHEETS_OWNER_EMAIL=

