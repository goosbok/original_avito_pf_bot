# ── Telegram Bot ──────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

ADMINS=471786676,257838190
SUPPORT_CHAT_ID=-5046696879
SUPPORT_THREAD_QUESTIONS=3
SUPPORT_THREAD_ORDERS=5
SUPPORT_THREAD_ERRORS=7
SUPPORT_THREAD_NEW_USERS=9
CODER=257838190
SUPPORT_TAG=avito_pf_otzizi
BOT_LINK=https://t.me/AVITOPF_bot
CHANNEL_LINK=https://t.me/pf_avito_top

# ── Web / JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace_me_with_32_char_random_string
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# В Docker — путь внутри named volume storage:/app/storage
DATABASE_PATH=/app/storage/database.db

# ── Yookassa payments ─────────────────────────────────────────────────────────
SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST=
# Payment health probe interval in minutes (0 = disabled, default 15)
PAYMENT_PROBE_INTERVAL_MIN=15

# ── Google Sheets exports ─────────────────────────────────────────────────────
# ID существующей Google-таблицы, в которую бот пишет все отчёты.
# Бот переписывает содержимое 4 вкладок (создаст недостающие):
#   "Все заказы"            — кнопка "📊 Google Sheets" в админке
#   "Заказы по юзеру"       — magic → юзер → orders
#   "Пополнения по юзеру"   — magic → юзер → refills
#   "Отзывы"                — админ-меню отзывов
# ВАЖНО: shared the spreadsheet with the service-account email as Editor
# (email — в utils/dev-trees-*.json поле client_email).
GSHEETS_TARGET_SHEET_ID=


# SMS provider for OTP-based login. Допустимые значения: stub (по умолчанию).
# Реализации smsc/smsaero и пр. добавляются в services/sms.py по мере подключения.
SMS_GATEWAY=stub

# === Domain topology (Task 17) ===
# Хост статического лендинга. Используется в кодовых референсах и в админ-сообщениях
# (например, ссылка "вернитесь на сайт" в /connect-боте).
LANDING_HOST=avito-pf.com
# Хост ЛК (FastAPI + SPA). Используется для return_url'ов YooKassa и для CORS.
# Канонический хост ЛК; если в окружении уже задан SITE_URL — LK_HOST имеет приоритет
# для нового кода (SITE_URL остаётся для обратной совместимости).
LK_HOST=lk.avito-pf.com

# ── Biznesklondaik PF executor (auto-mode) ────────────────────────────────────
# X-API-KEY для add-tasks.php (взять из docs.php их сервиса).
BIZA_API_KEY=
# Логин/пароль для скрейпа dashboard.php (read-only).
BIZA_LOGIN=
BIZA_PASSWORD=
# Базовые URL — менять только при миграции их инфры.
BIZA_API_BASE_URL=https://biznesklondaik.ru/fwdrjjkigor_new/api
BIZA_DASHBOARD_BASE_URL=https://biznesklondaik.ru/fwdrjjkigor_new/pf-avito

# Feature flags (оба default false).
# Включает nightly bulk-refresh кэша через scrape dashboard.
PF_PHRASE_CACHE_REFRESH_ENABLED=false
# Включает auto-режим в classifier'е (без него classifier всегда → manual).
PF_AUTO_DISPATCH_ENABLED=false

# Tuning.
PF_PHRASE_CACHE_CHUNK_DAYS=4          # окно при backfill
PF_PHRASE_CACHE_REFRESH_INTERVAL_H=24 # период refresh-cron'а
PF_DASHBOARD_REQUEST_DELAY_SEC=3      # пауза между чанками при backfill
PF_AUTO_RATE_METRIC_INTERVAL_H=1      # период метрики auto_rate
PF_DEFAULT_START_HOUR=0               # час старта накрутки на стороне исполнителя (0-23 МСК)
